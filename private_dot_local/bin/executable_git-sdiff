#!/usr/bin/env bash
# Compare two versions of a patch series with git range-diff.
#
# usage: git sdiff [<name>] [<old> [<new>]] [range-diff options]
#
# Versions are branches named <name>/v<n>, or failing that tags named
# <name>-v<n>. <old> and <new> may be written as 2 or v2. <name> defaults to
# the series of the checked-out <name>/v<n> branch.
#
#   git sdiff             previous version against the checked-out one (on v1,
#                         the whole series is shown as new)
#   git sdiff <old>       <old> against the checked-out version
#   git sdiff <old> <new> exactly those, <old> must be the older
#
# Each version's commits are found from its merge-base with the branch's
# upstream, so patches that were dropped show up as "<".
set -euo pipefail

die() { echo "sdiff: $*" >&2; exit 1; }

name=
if [ $# -gt 0 ] && ! [[ $1 =~ ^(v?[0-9]+|-.*)$ ]]; then
	name=$1
	shift
fi
vers=()
while [[ ${1:-} =~ ^v?[0-9]+$ ]]; do
	vers+=("${1#v}")
	shift
done

head=$(git symbolic-ref -q --short HEAD || true)
cur=
if [[ $head =~ ^(.+)/v([0-9]+)$ ]]; then
	[ -n "$name" ] || name=${BASH_REMATCH[1]}
	[ "${BASH_REMATCH[1]}" != "$name" ] || cur=${BASH_REMATCH[2]}
fi
[ -n "$name" ] || die "not on a <name>/v<n> branch, give the series name"

versions=$(git for-each-ref --format='%(refname:strip=3)' "refs/heads/$name/v*" |
	sed -n 's/^v\([0-9][0-9]*\)$/\1/p' | sort -n)
[ -n "$versions" ] || die "no branches $name/v*"
[ -n "$cur" ] || cur=$(tail -1 <<<"$versions")

ref() {
	if git rev-parse --verify -q "refs/heads/$name/v$1" >/dev/null; then
		echo "$name/v$1"
	elif git rev-parse --verify -q "refs/tags/$name-v$1" >/dev/null; then
		echo "$name-v$1"
	else
		die "no branch $name/v$1 or tag $name-v$1"
	fi
}

case ${#vers[@]} in
0)
	new=$cur
	old=$(awk -v c="$cur" '$1 < c' <<<"$versions" | tail -1)
	;;
1)
	old=${vers[0]}
	new=$cur
	;;
2)
	old=${vers[0]}
	new=${vers[1]}
	;;
*) die "too many versions" ;;
esac

if [ -n "$old" ] && [ "$old" -ge "$new" ]; then
	die "v$old is not older than v$new"
fi

newref=$(ref "$new")
upstream=$(git rev-parse --abbrev-ref "$newref@{upstream}" 2>/dev/null ||
	git rev-parse --abbrev-ref origin/HEAD)
newbase=$(git merge-base "$upstream" "$newref")

if [ -n "$old" ]; then
	oldref=$(ref "$old")
	oldrange="$(git merge-base "$upstream" "$oldref")..$oldref"
else
	oldref="nothing"
	oldrange=
fi

# range-diff rejects an empty old range, but with an old tip equal to the base it is empty
if [ -n "$oldrange" ]; then
	rd=("$oldrange" "$newbase..$newref")
else
	rd=("$newbase" "$newbase" "$newref")
fi

read -r dropped added changed same < <(git range-diff --no-color --no-patch "${rd[@]}" | awk '
	$3 == "<" { d++ }
	$3 == ">" { a++ }
	$3 == "!" { c++ }
	$3 == "=" { s++ }
	END { print d + 0, a + 0, c + 0, s + 0 }')

# the number in a colour per kind
count() {
	printf '\033[%sm%s\033[0m' "$2" "$1"
}

# label a version, marking the one that is checked out
label() {
	[ -n "$1" ] || { echo nothing; return; }
	if [ "$head" = "$name/v$1" ]; then echo "v$1 (current)"; else echo "v$1"; fi
}
versions_label="$(label "$old") vs. $(label "$new")"
heading="($name) $versions_label"
if [ -t 1 ]; then
	color=--color
	pager=$(git var GIT_PAGER)
	title=$(printf '\033[1;38;2;250;189;47m(%s)\033[0m \033[1m%s\033[0m   %s  %s  %s  %s' \
		"$name" "$versions_label" \
		"$(count "$dropped" 31)" "$(count "$added" 32)" \
		"$(count "$changed" 33)" "$(count "$same" 2)")
	plain="$heading   $dropped  $added  $changed  $same"
	pad=$(( ($(tput cols) - ${#plain}) / 2 ))
	[ "$pad" -gt 0 ] && title=$(printf '%*s%s' "$pad" '' "$title")
else
	color=
	pager=cat
	title="$heading   $dropped dropped  $added new  $changed changed  $same unchanged"
fi

{
	printf '%s\n\n' "$title"
	git --no-pager range-diff $color "$@" "${rd[@]}"
} | eval "$pager"
