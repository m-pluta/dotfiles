#!/usr/bin/env bash
# gcd-pick: fuzzy-pick a worktree across all git repos under $GCD_ROOT (default ~/dev),
# shown as a nested tree, and print its path. Use through the `gcd` shell function so
# the shell can cd there. Needs fzf >= 0.45 (transform, info-command).
#
# fzf calls back into this script for its binds and preview, so the pieces are
# subcommands: scan, render, move, info, preview. No subcommand runs the picker.

root="${GCD_ROOT:-$HOME/dev}"
# GCD_MODE=repo (set by the `repo` subcommand): repo rows are the selectable ones,
# worktrees are shown but not selectable, and every repo is listed.
mode="${GCD_MODE:-worktree}"
hdr=$'\e[1;38;2;255;40;40m'   # repo names
dirc=$'\e[2;37m'              # parent folders that are not repos
rst=$'\e[0m'

# jq program for repo mode: "path<TAB>columns" per worktree from `wt list --format=json`.
# Columns: status symbols, upstream ahead/behind, uncommitted diff, age, subject. Widths are
# fixed so they line up down the whole list, and colour is added after padding.
jq_cols='
def sp(n): if n > 0 then " " * n else "" end;
def col(code; txt; w): "\u001b[\(code)m\(txt)\u001b[0m" + sp(w - (txt | length));
def age: if (.head.committed_at // null) == null then "" else
      (now - (.head.committed_at | fromdateiso8601)) as $s
    | if $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h"
      elif $s < 2592000 then "\($s / 86400 | floor)d" else "\($s / 2592000 | floor)mo" end end;
.items[] | select(.worktree != null) | (.upstream // {}) as $u | .worktree.changes.diff as $d
| [ .worktree.path,
    ( col("33"; .display.symbols // ""; 6) + "  "
    + col("32"; (if ($u.ahead // 0) > 0 then "⇡\($u.ahead)" else "" end); 4)
    + col("31"; (if ($u.behind // 0) > 0 then "⇣\($u.behind)" else "" end); 5) + "  "
    + col("32"; (if $d.added > 0 then "+\($d.added)" else "" end); 6)
    + col("31"; (if $d.deleted > 0 then "-\($d.deleted)" else "" end); 6) + "  "
    + col("2"; age; 4) + "  "
    + col("2"; .head.subject; 0)) ] | @tsv'

# scan ROOT: one "relrepo<TAB>branch<TAB>path" line per worktree, for repos with linked worktrees
# (every repo in repo mode)
scan() {
    local root="$1" repo path branch head line ents n min=1
    [ "$mode" = repo ] && min=0
    while IFS= read -r repo; do
        ents="" n=0 path="" branch=""
        while IFS= read -r line; do
            case "$line" in
                "worktree "*) path="${line#worktree }"; branch="" ;;
                "branch "*) branch="${line#branch refs/heads/}" ;;
                "HEAD "*) head="${line#HEAD }" ;;
                detached) branch="(detached ${head:0:7})"; ((n == 0)) && branch="(main checkout)" ;;
                "") if [ -n "$path" ] && [[ "$path" != /tmp/* ]]; then
                        ents+="${repo#"$root"/}"$'\t'"${branch:-?}"$'\t'"$path"$'\n'; ((n++))
                    fi
                    path="" ;;
            esac
        done < <(git -C "$repo" worktree list --porcelain 2>/dev/null; echo)
        ((n > min)) && printf '%s' "$ents"
    done < <(find "$root" -maxdepth 4 -name .git -type d -not -path '*/.worktrees/*' -printf '%h\n' | sort)
}

# render SCANFILE QUERY: one header row per repo ("dir/" in grey, repo name in red) with its
# worktrees indented below, keeping only worktrees matching every query word (matched against
# "repo branch") with their repo header always kept.
# Rows whose path field is empty are not selectable, which is how move and info tell them apart.
render() {
    local file="$1" q="$2"
    local rel branch path info w hay ok rp bw p s dir name
    local -A seen inf rpath cnt
    local -a words
    read -ra words <<< "$q"
    # wt's columns arrive later from `fill`, so rows have none until info.tsv exists
    [ -f "${file%/*}/info.tsv" ] && while IFS=$'\t' read -r p s; do inf[$p]=$s; done < "${file%/*}/info.tsv"
    bw=$(branch_width "$file")
    # a repo's path is its first scan row (the main worktree), even when filtering hides that row
    while IFS=$'\t' read -r rel _ path; do
        [[ -v rpath[$rel] ]] || rpath[$rel]=$path
        cnt[$rel]=$((cnt[$rel] + 1))
    done < "$file"
    while IFS=$'\t' read -r rel branch path; do
        hay="${rel,,} ${branch,,}" ok=1
        for w in "${words[@]}"; do [[ "$hay" == *"${w,,}"* ]] || { ok=0; break; }; done
        ((ok)) || continue
        if [[ ! -v seen[$rel] ]]; then
            seen[$rel]=1
            dir="" name="$rel"
            [[ "$rel" == */* ]] && { dir="${rel%/*}/"; name="${rel##*/}"; }
            rp=""; [ "$mode" = repo ] && rp="${rpath[$rel]}"
            printf '%s%s%s%s%s%s\t%s\n' "$dirc" "$dir" "$rst" "$hdr" "$name" "$rst" "$rp"
        fi
        # repo mode lists every repo, but only repos with linked worktrees expand
        [ "$mode" = repo ] && ((cnt[$rel] < 2)) && continue
        if [ "$mode" = repo ]; then
            info="${inf[$path]}"
            printf '  %s%*s  %s\t\n' "$branch" $((bw - 2 - ${#branch})) '' "$info"
        else
            printf '  %s\t%s\n' "$branch" "$path"
        fi
    done < "$file"
}

# branch_width SCANFILE: width of the indent + branch column, over the whole scan so the
# columns stay put while filtering
branch_width() {
    awk -F'\t' -v repo="$([ "$mode" = repo ] && echo 1)" '
        NR == FNR { c[$1]++; next }
        !repo || c[$1] > 1 { l = 2 + length($2); if (l > m) m = l }
        END { print m + 0 }' "$1" "$1"
}

# heading SCANFILE: column titles for repo mode, lined up with the columns `jq_cols` builds
heading() {
    printf '\e[2m%-*s  %-6s  %-9s  %-12s  %-4s  %s\e[0m\n' "$(branch_width "$1")" "Repo" Status Remote Changes Age Message
}

# move FILE up|down POS: print an fzf pos() action for the next worktree row, skipping headers
move() {
    local file="$1" dir="$2" pos="$3" n i step l
    local -a rows
    mapfile -t rows < "$file"
    n=${#rows[@]}
    ((n)) || return
    step=1; [ "$dir" = up ] && step=-1
    for ((i = 1; i <= n; i++)); do
        l=$(( (pos - 1 + step * i) % n ))
        ((l < 0)) && l=$((l + n))
        [[ "${rows[l]}" == *$'\t'?* ]] && { echo "pos($((l + 1)))"; return; }
    done
}

# info CURFILE SCANFILE: fzf counter as worktree position/matches, ignoring header rows
info() {
    local pos="${FZF_POS:-0}" cur=0 shown=0 total i
    local -a rows
    mapfile -t rows < "$1"
    for ((i = 0; i < ${#rows[@]}; i++)); do
        [[ "${rows[i]}" == *$'\t'?* ]] || continue
        ((shown++))
        ((i + 1 <= pos)) && cur=$shown
    done
    if [ "$mode" = repo ]; then total=$(cut -f1 "$2" | uniq | wc -l); else total=$(wc -l < "$2"); fi
    if ((shown == total)); then echo "$cur/$shown"; else echo "$cur/$shown ($total)"; fi
}

# preview PATH: ahead/behind, then the branch's own commits on top of the base's history.
# Base is the branch checked out in the repo's main worktree, else local main/master.
preview() {
    local p="$1" base b up ab mb
    [ -z "$p" ] && return
    local g=(git -C "$p")
    base=$(git -C "$("${g[@]}" worktree list --porcelain | sed -n '1s/^worktree //p')" symbolic-ref -q --short HEAD)
    if [ -z "$base" ]; then
        for b in main master; do
            "${g[@]}" rev-parse -q --verify "$b" >/dev/null && { base=$b; break; }
        done
    fi
    up=$("${g[@]}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
    if [ -n "$up" ]; then
        ab=$("${g[@]}" rev-list --left-right --count "$up"...HEAD)
        printf '\e[32m↑%s\e[0m \e[31m↓%s\e[0m \e[2m%s\e[0m\n' "${ab#*$'\t'}" "${ab%$'\t'*}" "$up"
    else
        printf '\e[2mno upstream\e[0m\n'
    fi
    printf '\n'
    # one continuous list: this branch's own commits in green, then the base's commits from the
    # fork point down in yellow. Long enough to fill the pane and be scrolled.
    mb=$([ -n "$base" ] && "${g[@]}" merge-base "$base" HEAD 2>/dev/null)
    if [ -n "$mb" ]; then
        "${g[@]}" log --color=always --format='%C(green)%h%C(reset) %s' "$mb"..HEAD
        "${g[@]}" log -n 500 --color=always --format='%C(yellow)%h%C(reset) %C(dim)%s%C(reset)' "$mb"
    else
        "${g[@]}" log -n 500 --color=always --format='%C(yellow)%h%C(reset) %C(dim)%s%C(reset)'
    fi
}

# fill TMP PORT: repo mode background job. Run `wt list` for every repo in parallel, collect the
# columns into TMP/info.tsv, then tell the running fzf (on PORT) to refresh its list once.
fill() {
    local tmp="$1" port="$2" self repo
    self=$(readlink -f "$0")
    while IFS= read -r repo; do
        ( wt -C "$repo" list --format=json 2>/dev/null | jq -r "$jq_cols" > "$tmp/info.$$.${repo//\//_}" ) &
    done < <(awk -F'\t' '{ c[$1]++; if (!($1 in p)) p[$1] = $3 } END { for (r in c) if (c[r] > 1) print p[r] }' "$tmp/scan")
    wait
    cat "$tmp"/info.$$.* > "$tmp/info.tsv" 2>/dev/null
    rm -f "$tmp"/info.$$.*
    curl -s -XPOST "localhost:$port" -d "transform:$self refresh $tmp \$FZF_POS {q}"
}

# refresh TMP POS QUERY: print the fzf action that re-renders the list and puts the cursor back
refresh() {
    printf 'reload-sync(%s render %s/scan %q | tee %s/cur)+pos(%s)' "$(readlink -f "$0")" "$1" "$3" "$1" "$2"
}

pick() {
    local self tmp sel
    local -a prev=()
    self=$(readlink -f "$0")
    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" EXIT
    scan "$root" > "$tmp/scan"
    [ -s "$tmp/scan" ] || { echo "gcd-pick: no repos with worktrees under $root" >&2; return 1; }
    render "$tmp/scan" "" > "$tmp/cur"
    # repo mode shows wt's columns on each row (filled in async) instead of a preview pane
    if [ "$mode" = repo ]; then
        prev=(--listen=0 --header="$(heading "$tmp/scan")" --bind "start:execute-silent($self fill $tmp \$FZF_PORT >/dev/null 2>&1 &)")
    else
        prev=(--preview="$self preview {2}" --preview-window=right:55%
            --bind "shift-up:preview-up,shift-down:preview-down,page-up:preview-page-up,page-down:preview-page-down")
    fi

    # Up/down jump straight to the next worktree row via transform, and filtering
    # reloads the tree so a match keeps its parent headers.
    sel=$(fzf --ansi --disabled --delimiter=$'\t' --with-nth=1 \
        --reverse --prompt='worktree> ' \
        --info-command="$self info $tmp/cur $tmp/scan" \
        --bind "change:reload:$self render $tmp/scan {q} | tee $tmp/cur" \
        --bind "load:transform:$self move $tmp/cur down 0" \
        --bind "down,ctrl-n:transform:$self move $tmp/cur down \$FZF_POS" \
        --bind "up,ctrl-p:transform:$self move $tmp/cur up \$FZF_POS" \
        --bind "enter:transform:[ -n {2} ] && echo accept" \
        "${prev[@]}" < "$tmp/cur") || return 1
    printf '%s\n' "${sel#*$'\t'}"
}

cmd="${1:-pick}"
case "$cmd" in
    scan | render | heading | move | info | preview | fill | refresh | pick) shift $(($# > 0 ? 1 : 0)); "$cmd" "$@" ;;
    repo) export GCD_MODE=repo; mode=repo; pick ;;
    *) echo "usage: gcd-pick [repo|scan|render|move|info|preview]" >&2; exit 2 ;;
esac
