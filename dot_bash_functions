cd () {
    builtin cd "$@" || return
    limit=50
    count=$(ls -1 | wc -l)
    if [ "$count" -le "$limit" ]; then
        ls
    fi
}

mkcd() {
    mkdir -p "$1" && cd "$1"
}

cb() {
    # Check if an argument is provided
    if [ -z "$1" ]; then
        echo "Usage: cb <number_of_levels>"
        return 1
    fi

    # Get the number of levels to go up
    levels=$1

    # Build the directory path with n ".."
    path=""
    for ((i = 0; i < levels; i++)); do
        path+="../"
    done

    # Change to the constructed path
    cd "$path" || return
}

addalias() {
    local alias_name="$1"
    shift
    local command="$*"

    if [[ -z "$alias_name" || -z "$command" ]]; then
        echo "Usage: addalias <alias_name> <command>"
        return 1
    fi

    # Ensure ~/.bash_aliases exists
    touch ~/.bash_aliases

   # Append the new alias (properly quoted)
    echo "alias $alias_name='$command'" >> ~/.bash_aliases

    # Ensure ~/.bash_aliases is sourced in ~/.bashrc
    if ! grep -q "source ~/.bash_aliases" ~/.bashrc; then
        echo "source ~/.bash_aliases" >> ~/.bashrc
    fi

    # Apply the alias immediately
    source ~/.bash_aliases

    echo "Alias '$alias_name' added successfully."
}

function flagman() {
  emulate -L zsh

  local cmd=$1
  local out
  out=$(man "$cmd") || return $?
  out=$(echo "$out" | col -b)

  local cleaned=$(echo "$out" | grep -E "^\s*-")
  [[ -z "$cleaned" ]] && cleaned=$out

  local padding=3
  # Write to file to avoid passing large strings on the command line
  local tmpfile=$(mktemp)
  echo "$out" > "$tmpfile"
  local match=$(echo "$cleaned" | fzf --ansi --preview "cat $tmpfile | grep -A \$(expr \$(tput lines) - $padding) -B 0 \"\$(echo {} | sed 's/[\\\"\\[*^$]/\\\\&/g')\"")
  rm "$tmpfile"

  [[ -z "$match" ]] && return;

  local escaped=$(echo "$match" | sed 's/[.[\(*^$+?{|]/\\&/g')

  echo "$out" | less +/"$escaped"
}

if [[ -n "$ZSH_VERSION" ]]; then
  compdef _man flagman
fi

rmalias() {
    local alias_name="$1"

    if [[ -z "$alias_name" ]]; then
        echo "Usage: removealias <alias_name>"
        return 1
    fi

    # Ensure ~/.bash_aliases exists
    touch ~/.bash_aliases

    # Comment out the alias if it exists and is not already commented
    if grep -q "^alias $alias_name=" ~/.bash_aliases; then
        sed -i "s/^alias $alias_name=/# alias $alias_name=/" ~/.bash_aliases
        echo "Alias '$alias_name' has been commented out in ~/.bash_aliases."
    else
        echo "Alias '$alias_name' not found in ~/.bash_aliases."
    fi

    # Apply changes immediately
    unalias "$alias_name" 2>/dev/null

    echo "Run 'source ~/.bash_aliases' to refresh manually, or restart your shell."
}


flamegraph() {
    if [ -z "$1" ]; then
        echo "Usage:   flamegraph \"<your_command_here>\" [frequency]"
        echo "Example: flamegraph \"ls -l\" 99"
        return 1
    fi
    ls -lAh    
    local freq=${2:-99}

    # Check if FlameGraph directory exists, if not clone it
    local flamegraph_dir="$HOME/FlameGraph"
    if [ ! -d "$flamegraph_dir" ]; then
        echo "FlameGraph directory not found at $flamegraph_dir"
        echo "Cloning FlameGraph from GitHub..."
        git clone https://github.com/brendangregg/FlameGraph.git "$flamegraph_dir" || {
            echo "Failed to clone FlameGraph."
            echo "Clone using git clone https://github.com/brendangregg/FlameGraph.git"
            return 1
        }
    fi

    # Generate the flamegraph
    perf record -F "$freq" -a -g -- bash -c "$1" && \
    perf script | perl "$flamegraph_dir/stackcollapse-perf.pl" | perl "$flamegraph_dir/flamegraph.pl" --hash > flamegraph.svg

    local full_path="$(realpath flamegraph.svg)"
    if [ -f "$full_path" ]; then
        echo "Flamegraph saved to $full_path"

        # Auto-upload the flamegraph and get the link
        local upload_response=$(upload "$full_path")
        echo "$upload_response"
    else
        echo "Failed to generate flamegraph."
    fi
}

upload() {
    if [ -z "$1" ]; then
        echo "Usage: upload <path_to_file_or_directory>"
        echo "Directories are saved as a .tar.gz"
        return 1
    fi

    local file_path="$1"

    if [ -d "$file_path" ]; then
        local tar_file="${file_path%/}.tar.gz"
        tar -czf "$tar_file" -C "$(dirname "$file_path")" "$(basename "$file_path")" || {
            echo "Failed to create tar.gz archive from directory: $file_path"
            return 1
        }
        file_path="$tar_file"
        echo "Directory archived as: $(realpath "$file_path")"
    elif [ ! -f "$file_path" ]; then
        echo "File not found: $file_path"
        return 1
    fi

    # Upload the file
    local response=$(curl -s -F "file=@$file_path" https://tmpfiles.org/api/v1/upload)

    # Extract the URL from the response
    local url=$(echo "$response" | grep -oP '"url":"\K[^"]+')

    if [ -n "$url" ]; then
        echo "File uploaded successfully: $url"
    else
        echo "Failed to upload file."
    fi
}

background_run() {
  local cmd="$1"
  local outfile="$2"
  local pidfile="${3:-.background_pids}"  # default PID file

  if [[ -z "$cmd" || -z "$outfile" ]]; then
    echo "Usage: background_run \"<command>\" \"<output_file\" [pid_file]"
    return 1
  fi

  touch "$outfile"
  nohup bash -c "$cmd" &>>"$outfile" < /dev/null &
  local pid=$!
  echo "$pid" >> "$pidfile"

  echo "Started: '$cmd'"
  echo "PID: $pid"
  echo "Logging to: $outfile"
  echo "Tracking PID in: $pidfile"
}

kill_background() {
  local pidfile="${1:-.background_pids}"

  if [[ ! -f "$pidfile" ]]; then
    echo "No PID file found: $pidfile"
    return 1
  fi

  while read -r pid; do
    if kill -0 "$pid" 2>/dev/null; then
      echo "Killing PID: $pid"
      kill "$pid"
    else
      echo "PID $pid is not running"
    fi
  done < "$pidfile"

  rm -f "$pidfile"
  echo "Cleared PID file: $pidfile"
}

flagman() {
  local cmd="$1"
  local out cleaned match escaped tmpfile padding

  # No emulate in bash
  out=$(man "$cmd" | col -b) || return $?
  cleaned=$(echo "$out" | grep -E "^\s*-")
  [[ -z "$cleaned" ]] && cleaned="$out"

  padding=3
  tmpfile=$(mktemp)
  echo "$out" > "$tmpfile"

  match=$(echo "$cleaned" | fzf \
    --ansi \
    --bind='ctrl-space:toggle-preview,ctrl-w:toggle-preview-wrap' \
    --preview-label='Toggle preview: CTRL+SPACE; Toggle wrapping: CTRL+W' \
    --preview "grep -A \$(expr \$(tput lines) - $padding) -B 0 \"\$(echo {} | sed 's/[\\\"\\[*^$]/\\\\&/g')\" $tmpfile")

  rm -f "$tmpfile"
  [[ -z "$match" ]] && return

  escaped=$(echo "$match" | sed 's/[.[\(*^$+?{|]/\\&/g')
  echo "$out" | less +/"$escaped"
}

# Prompt to delete /tmp/claude/* session dirs older than 30 days.
prune-claude() {
    local dirs=()
    while IFS= read -r -d '' d; do
        dirs+=("$d")
    done < <(find /tmp/claude -maxdepth 1 -mindepth 1 -type d -mtime +30 -print0 2>/dev/null)

    if [ "${#dirs[@]}" -eq 0 ]; then
        echo "No /tmp/claude session dirs older than 30 days."
        return 0
    fi

    echo "The following session dirs are older than 30 days:"
    printf '  %s\n' "${dirs[@]}"
    read -r -p "Delete these ${#dirs[@]} dir(s)? [y/N] " reply
    case "$reply" in
        [yY]|[yY][eE][sS]) rm -rf -- "${dirs[@]}" && echo "Deleted." ;;
        *) echo "Aborted." ;;
    esac
}


# gcd: fuzzy-pick a worktree across all git repos under ~/dev, shown as a tree
_gcd_preview() {
    local p="$1" base b ahead
    [ -z "$p" ] && return
    local g=(git -C "$p")
    # base = branch checked out in the repo's main worktree, else main/master
    base=$(git -C "$("${g[@]}" worktree list --porcelain | sed -n '1s/^worktree //p')" symbolic-ref -q --short HEAD)
    if [ -z "$base" ]; then
        for b in main master; do
            "${g[@]}" rev-parse -q --verify "$b" >/dev/null && { base=$b; break; }
        done
    fi
    [ -z "$base" ] && base=$("${g[@]}" symbolic-ref -q --short refs/remotes/origin/HEAD)
    local up ab
    up=$("${g[@]}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
    if [ -n "$up" ]; then
        ab=$("${g[@]}" rev-list --left-right --count "$up"...HEAD)
        printf '\e[32m↑%s\e[0m \e[31m↓%s\e[0m \e[2m%s\e[0m\n' "${ab#*$'\t'}" "${ab%$'\t'*}" "$up"
    else
        printf '\e[2mno upstream\e[0m\n'
    fi
    if [ -n "$base" ] && [ "$("${g[@]}" rev-parse HEAD)" != "$("${g[@]}" rev-parse "$base")" ]; then
        ahead=$("${g[@]}" rev-list --count "$base"..HEAD)
        if [ "$ahead" -gt 0 ]; then
            printf '\n\e[1;32m== %s commits on top of %s ==\e[0m\n' "$ahead" "$base"
            "${g[@]}" log --color=always --format='%C(green)%h%C(reset) %s' "$base"..HEAD
        fi
    fi
    if [ -n "$base" ]; then
        printf '\n\e[1;33m== %s ==\e[0m\n' "$base"
        "${g[@]}" log -n 8 --color=always --format='%C(yellow)%h%C(reset) %C(dim)%s%C(reset)' "$base"
    else
        printf '\n'; "${g[@]}" log -n 8 --oneline --color=always
    fi
}
export -f _gcd_preview

# scan: one "relrepo<TAB>branch<TAB>path" line per worktree, for repos with linked worktrees
_gcd_scan() {
    local root="$1" repo path branch head line ents n
    while IFS= read -r repo; do
        ents="" n=0 path="" branch=""
        while IFS= read -r line; do
            case "$line" in
                "worktree "*) path="${line#worktree }"; branch="" ;;
                "branch "*) branch="${line#branch refs/heads/}" ;;
                "HEAD "*) head="${line#HEAD }" ;;
                detached) branch="(detached ${head:0:7})"; ((n == 0)) && branch="(main checkout)" ;;
                "") if [ -n "$path" ] && [[ "$path" != /tmp/* ]]; then
                        ents+="${repo#"$root"/}"$'\t'"${branch:-?}"$'\t'"$path"$'\n'; ((n++))
                    fi
                    path="" ;;
            esac
        done < <(git -C "$repo" worktree list --porcelain 2>/dev/null; echo)
        ((n > 1)) && printf '%s' "$ents"
    done < <(find "$root" -maxdepth 4 -name .git -type d -not -path '*/.worktrees/*' -printf '%h\n' | sort)
}

# render: nested tree from a scan file, keeping only worktrees matching every query word
# (matched against "repo branch"), with their parent headers always kept
_gcd_render() {
    local file="$1" q="$2" hdr=$'\e[1;38;2;255;40;40m' dirc=$'\e[2;37m' rst=$'\e[0m'
    local rel branch path d w hay ok c
    local -a parts prev=() words
    read -ra words <<< "$q"
    while IFS=$'\t' read -r rel branch path; do
        hay="${rel,,} ${branch,,}" ok=1
        for w in "${words[@]}"; do [[ "$hay" == *"${w,,}"* ]] || { ok=0; break; }; done
        ((ok)) || continue
        IFS=/ read -ra parts <<< "$rel"
        for ((d = 0; d < ${#parts[@]}; d++)); do
            [ "${prev[d]}" = "${parts[d]}" ] && [ "${prev[*]:0:d}" = "${parts[*]:0:d}" ] && continue
            c=$dirc; ((d == ${#parts[@]} - 1)) && c=$hdr
            printf '%*s%s%s%s\t\n' $((d * 2)) '' "$c" "${parts[d]}" "$rst"
        done
        prev=("${parts[@]}")
        printf '%*s%s\t%s\n' $((${#parts[@]} * 2)) '' "$branch" "$path"
    done < "$file"
}
export -f _gcd_render

# _gcd_move FILE up|down POS: print an fzf pos() action for the next selectable row
# (rows with an empty path field are headers), wrapping at the ends
_gcd_move() {
    local file="$1" dir="$2" pos="$3" n i step l
    local -a rows
    mapfile -t rows < "$file"
    n=${#rows[@]}
    ((n)) || return
    step=1; [ "$dir" = up ] && step=-1
    for ((i = 1; i <= n; i++)); do
        l=$(( (pos - 1 + step * i) % n ))
        ((l < 0)) && l=$((l + n))
        [[ "${rows[l]}" == *$'\t'?* ]] && { echo "pos($((l + 1)))"; return; }
    done
}
export -f _gcd_move

# _gcd_info CUR SCAN: fzf counter as worktree position/matches/total, ignoring header rows
_gcd_info() {
    local pos="${FZF_POS:-0}" cur=0 shown=0 total i l
    local -a rows
    mapfile -t rows < "$1"
    for ((i = 0; i < ${#rows[@]}; i++)); do
        [[ "${rows[i]}" == *$'\t'?* ]] || continue
        ((shown++))
        ((i + 1 <= pos)) && cur=$shown
    done
    total=$(wc -l < "$2")
    if ((shown == total)); then echo "  $cur/$shown"; else echo "  $cur/$shown ($total)"; fi
}
export -f _gcd_info

gcd() {
    local root="${GCD_ROOT:-$HOME/dev}" tmp sel path
    tmp=$(mktemp -d)
    _gcd_scan "$root" > "$tmp/scan"
    [ -s "$tmp/scan" ] || { echo "gcd: no repos with worktrees under $root" >&2; rm -rf "$tmp"; return 1; }
    _gcd_render "$tmp/scan" "" > "$tmp/cur"

    # Headers are rows with an empty path field. Up/down jump straight to the next
    # worktree row via transform, and filtering reloads the tree so parent headers stay.
    sel=$(SHELL=$(command -v bash) fzf --ansi --disabled --delimiter=$'\t' --with-nth=1 \
        --height=70% --reverse --prompt='worktree> ' \
        --info-command="_gcd_info $tmp/cur $tmp/scan" \
        --bind "start:transform:_gcd_move $tmp/cur down 0" \
        --bind "change:reload:_gcd_render $tmp/scan {q} | tee $tmp/cur" \
        --bind "load:transform:_gcd_move $tmp/cur down 0" \
        --bind "down:transform:_gcd_move $tmp/cur down \$FZF_POS" \
        --bind "up:transform:_gcd_move $tmp/cur up \$FZF_POS" \
        --bind "ctrl-n:transform:_gcd_move $tmp/cur down \$FZF_POS" \
        --bind "ctrl-p:transform:_gcd_move $tmp/cur up \$FZF_POS" \
        --bind "enter:transform:[ -n {2} ] && echo accept" \
        --preview='_gcd_preview {2}' --preview-window=right:55% < "$tmp/cur") || { rm -rf "$tmp"; return; }
    path="${sel#*$'\t'}"
    rm -rf "$tmp"
    cd "$path"
}
